 338:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** RESULT Standard_SetEndPointFeature(void)
 339:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** {
 340:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t    wIndex0;
 341:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t    Related_Endpoint;
 342:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t    rEP;
 343:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t    Status;
 344:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 345:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   wIndex0 = pInformation->USBwIndex0;
 346:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   rEP = wIndex0 & ~0x80;
 347:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   Related_Endpoint = ENDP0 + rEP;
 348:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 349:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (ValBit(pInformation->USBwIndex0, 7))
 350:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 351:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* get Status of endpoint & stall the request if the related_ENdpoint
 352:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     is Disabled*/
 353:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     Status = _GetEPTxStatus(Related_Endpoint);
 354:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 355:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
 356:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 357:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     Status = _GetEPRxStatus(Related_Endpoint);
 358:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 359:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 360:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (Related_Endpoint >= Device_Table.Total_Endpoint
 361:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       || pInformation->USBwValue != 0 || Status == 0
 362:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       || pInformation->Current_Configuration == 0)
 363:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 364:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     return USB_UNSUPPORT;
 365:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 366:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
 367:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 368:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if (wIndex0 & 0x80)
 369:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 370:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       /* IN endpoint */
 371:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       _SetEPTxStatus(Related_Endpoint, EP_TX_STALL);
 372:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 373:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 374:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     else
 375:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 376:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       /* OUT endpoint */
 377:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       _SetEPRxStatus(Related_Endpoint, EP_RX_STALL);
 378:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 379:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 380:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   pUser_Standard_Requests->User_SetEndPointFeature();
 381:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   return USB_SUCCESS;
 382:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** }
