 271:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     rEP = wIndex0 & ~0x80;
 272:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     Related_Endpoint = ENDP0 + rEP;
 273:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 274:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if (ValBit(pInformation->USBwIndex0, 7))
 275:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 276:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       /*Get Status of endpoint & stall the request if the related_ENdpoint
 277:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       is Disabled*/
 278:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       Status = _GetEPTxStatus(Related_Endpoint);
 279:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 280:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     else
 281:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 282:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       Status = _GetEPRxStatus(Related_Endpoint);
 283:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 284:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 285:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if ((rEP >= pDev->Total_Endpoint) || (Status == 0)
 286:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         || (pInformation->Current_Configuration == 0))
 287:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 288:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       return USB_UNSUPPORT;
 289:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 290:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 291:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 292:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if (wIndex0 & 0x80)
 293:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 294:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       /* IN endpoint */
 295:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       if (_GetTxStallStatus(Related_Endpoint ))
 296:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       {
 297:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       #ifndef STM32F10X_CL
