 119:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** /*******************************************************************************
 120:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Function Name  : Standard_SetInterface.
 121:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Description    : This routine is called to set the interface.
 122:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  Then each class should configure the interface them self.
 123:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Input          : None.
 124:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Output         : None.
 125:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Return         : - Return USB_SUCCESS, if the request is performed.
 126:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  - Return USB_UNSUPPORT, if the request is invalid.
 127:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *******************************************************************************/
 128:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** RESULT Standard_SetInterface(void)
 129:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** {
 130:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   RESULT Re;
 131:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   /*Test if the specified Interface and Alternate Setting are supported by
 132:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     the application Firmware*/
 133:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   Re = (*pProperty->Class_Get_Interface_Setting)(pInformation->USBwIndex0, pInformation->USBwValue0
 134:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 135:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (pInformation->Current_Configuration != 0)
 136:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 137:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if ((Re != USB_SUCCESS) || (pInformation->USBwIndex1 != 0)
 138:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         || (pInformation->USBwValue1 != 0))
 139:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 140:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       return  USB_UNSUPPORT;
 141:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 142:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     else if (Re == USB_SUCCESS)
 143:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 144:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       pUser_Standard_Requests->User_SetInterface();
 145:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       pInformation->Current_Interface = pInformation->USBwIndex0;
 146:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       pInformation->Current_AlternateSetting = pInformation->USBwValue0;
 147:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       return USB_SUCCESS;
 148:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
