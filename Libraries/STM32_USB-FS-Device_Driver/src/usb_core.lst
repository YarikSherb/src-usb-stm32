 399:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** /*******************************************************************************
 400:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Function Name  : Standard_GetDescriptorData.
 401:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Description    : Standard_GetDescriptorData is used for descriptors transfer.
 402:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                : This routine is used for the descriptors resident in Flash
 403:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  or RAM
 404:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  pDesc can be in either Flash or RAM
 405:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  The purpose of this routine is to have a versatile way to
 406:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  response descriptors request. It allows user to generate
 407:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  certain descriptors with software or read descriptors from
 408:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  external storage part by part.
 409:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Input          : - Length - Length of the data in this transfer.
 410:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  - pDesc - A pointer points to descriptor struct.
 411:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  The structure gives the initial address of the descriptor and
 412:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  its original size.
 413:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Output         : None.
 414:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Return         : Address of a part of the descriptor pointed by the Usb_
 415:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  wOffset The buffer pointed by this address contains at least
 416:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  Length bytes.
 417:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *******************************************************************************/
 418:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** uint8_t *Standard_GetDescriptorData(uint16_t Length, ONE_DESCRIPTOR *pDesc)
 419:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** {
 420:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t  wOffset;
 421:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 422:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   wOffset = pInformation->Ctrl_Info.Usb_wOffset;
 423:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (Length == 0)
 424:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 425:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->Ctrl_Info.Usb_wLength = pDesc->Descriptor_Size - wOffset;
 426:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     return 0;
 427:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 428:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 429:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   return pDesc->Descriptor + wOffset;
 430:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** }
 431:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 432:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** /*******************************************************************************
 433:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Function Name  : DataStageOut.
 434:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Description    : Data stage of a Control Write Transfer.
 435:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Input          : None.
 436:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Output         : None.
 437:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Return         : None.
 438:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *******************************************************************************/
 439:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** void DataStageOut(void)
 440:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** {
 441:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   ENDPOINT_INFO *pEPinfo = &pInformation->Ctrl_Info;
 442:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t save_rLength;
 443:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 444:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   save_rLength = pEPinfo->Usb_rLength;
 445:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 446:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (pEPinfo->CopyData && save_rLength)
 447:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 448:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     uint8_t *Buffer;
 449:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     uint32_t Length;
 450:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 451:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     Length = pEPinfo->PacketSize;
 452:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if (Length > save_rLength)
 453:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 454:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       Length = save_rLength;
 455:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 456:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 457:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     Buffer = (*pEPinfo->CopyData)(Length);
 458:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pEPinfo->Usb_rLength -= Length;
 459:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pEPinfo->Usb_rOffset += Length;
 460:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 461:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   #ifdef STM32F10X_CL  
 462:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     PCD_EP_Read(ENDP0, Buffer, Length); 
 463:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   #else  
 464:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     PMAToUserBufferCopy(Buffer, GetEPRxAddr(ENDP0), Length);
 465:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   #endif  /* STM32F10X_CL */
 466:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 467:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 468:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (pEPinfo->Usb_rLength != 0)
 469:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 470:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     vSetEPRxStatus(EP_RX_VALID);/* re-enable for next data reception */
 471:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     SetEPTxCount(ENDP0, 0);
 472:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     vSetEPTxStatus(EP_TX_VALID);/* Expect the host to abort the data OUT stage */
 473:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 474:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   /* Set the next State*/
 475:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (pEPinfo->Usb_rLength >= pEPinfo->PacketSize)
 476:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 477:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->ControlState = OUT_DATA;
 478:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 479:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
 480:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 481:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if (pEPinfo->Usb_rLength > 0)
 482:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 483:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       pInformation->ControlState = LAST_OUT_DATA;
 484:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 485:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     else if (pEPinfo->Usb_rLength == 0)
 486:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 487:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       pInformation->ControlState = WAIT_STATUS_IN;
 488:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       USB_StatusIn();
 489:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 490:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 491:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** }
 492:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
