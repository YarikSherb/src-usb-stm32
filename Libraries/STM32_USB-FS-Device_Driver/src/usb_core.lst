 783:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if (Type_Recipient == (STANDARD_REQUEST | DEVICE_RECIPIENT))
 784:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 785:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       CopyRoutine = Standard_GetConfiguration;
 786:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 787:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 788:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   /*GET INTERFACE*/
 789:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else if (Request_No == GET_INTERFACE)
 790:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 791:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if ((Type_Recipient == (STANDARD_REQUEST | INTERFACE_RECIPIENT))
 792:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         && (pInformation->Current_Configuration != 0) && (pInformation->USBwValue == 0)
 793:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         && (pInformation->USBwIndex1 == 0) && (pInformation->USBwLength == 0x0001)
 794:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         && ((*pProperty->Class_Get_Interface_Setting)(pInformation->USBwIndex0, 0) == USB_SUCCESS))
 795:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 796:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       CopyRoutine = Standard_GetInterface;
 797:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 798:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 799:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 800:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   
 801:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (CopyRoutine)
 802:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 803:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->Ctrl_Info.Usb_wOffset = wOffset;
 804:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->Ctrl_Info.CopyData = CopyRoutine;
 805:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* sb in the original the cast to word was directly */
 806:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* now the cast is made step by step */
 807:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     (*CopyRoutine)(0);
 808:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     Result = USB_SUCCESS;
 809:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 810:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
 811:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 812:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     Result = (*pProperty->Class_Data_Setup)(pInformation->USBbRequest);
 813:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if (Result == USB_NOT_READY)
 814:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 815:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       pInformation->ControlState = PAUSE;
 816:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       return;
 817:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 818:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 819:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 820:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (pInformation->Ctrl_Info.Usb_wLength == 0xFFFF)
 821:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 822:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* Data is not ready, wait it */
 823:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->ControlState = PAUSE;
 824:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     return;
 825:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 826:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if ((Result == USB_UNSUPPORT) || (pInformation->Ctrl_Info.Usb_wLength == 0))
 827:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 828:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* Unsupported request */
 829:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->ControlState = STALLED;
 830:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     return;
 831:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 832:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 833:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 834:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (ValBit(pInformation->USBbmRequestType, 7))
 835:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 836:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* Device ==> Host */
 837:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     __IO uint32_t wLength = pInformation->USBwLength;
 838:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****      
 839:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* Restrict the data length to be the one host asks for */
 840:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if (pInformation->Ctrl_Info.Usb_wLength > wLength)
 841:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 842:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       pInformation->Ctrl_Info.Usb_wLength = wLength;
 843:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 844:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     
 845:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     else if (pInformation->Ctrl_Info.Usb_wLength < pInformation->USBwLength)
 846:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 847:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       if (pInformation->Ctrl_Info.Usb_wLength < pProperty->MaxPacketSize)
 848:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       {
 849:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         Data_Mul_MaxPacketSize = FALSE;
 850:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       }
 851:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       else if ((pInformation->Ctrl_Info.Usb_wLength % pProperty->MaxPacketSize) == 0)
 852:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       {
 853:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         Data_Mul_MaxPacketSize = TRUE;
 854:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       }
 855:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }   
 856:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 857:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->Ctrl_Info.PacketSize = pProperty->MaxPacketSize;
 858:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     DataStageIn();
 859:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 860:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
 861:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 862:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->ControlState = OUT_DATA;
 863:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     vSetEPRxStatus(EP_RX_VALID); /* enable for next data reception */
 864:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 865:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 866:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   return;
 867:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** }
 868:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 869:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** /*******************************************************************************
 870:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Function Name  : Setup0_Process
 871:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Description    : Get the device request data and dispatch to individual process.
 872:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Input          : None.
 873:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Output         : None.
 874:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Return         : Post0_Process.
 875:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *******************************************************************************/
 876:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** uint8_t Setup0_Process(void)
 877:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** {
 878:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 879:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   union
 880:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 881:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     uint8_t* b;
 882:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     uint16_t* w;
 883:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   } pBuf;
 884:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 885:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** #ifdef STM32F10X_CL
 886:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   USB_OTG_EP *ep;
 887:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint16_t offset = 0;
 888:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****  
 889:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   ep = PCD_GetOutEP(ENDP0);
 890:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   pBuf.b = ep->xfer_buff;
 891:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** #else  
 892:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint16_t offset = 1;
 893:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   
 894:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   pBuf.b = PMAAddr + (uint8_t *)(_GetEPRxAddr(ENDP0) * 2); /* *2 for 32 bits addr */
 895:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** #endif /* STM32F10X_CL */
 896:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 897:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (pInformation->ControlState != PAUSE)
 898:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 899:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->USBbmRequestType = *pBuf.b++; /* bmRequestType */
 900:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->USBbRequest = *pBuf.b++; /* bRequest */
 901:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pBuf.w += offset;  /* word not accessed because of 32 bits addressing */
 902:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->USBwValue = ByteSwap(*pBuf.w++); /* wValue */
 903:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pBuf.w += offset;  /* word not accessed because of 32 bits addressing */
 904:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->USBwIndex  = ByteSwap(*pBuf.w++); /* wIndex */
 905:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pBuf.w += offset;  /* word not accessed because of 32 bits addressing */
 906:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->USBwLength = *pBuf.w; /* wLength */
 907:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 908:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 909:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   pInformation->ControlState = SETTING_UP;
 910:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (pInformation->USBwLength == 0)
 911:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 912:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* Setup with no data stage */
 913:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     NoData_Setup0();
 914:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 915:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
 916:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 917:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* Setup with data stage */
 918:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     Data_Setup0();
 919:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 920:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   return Post0_Process();
 921:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** }
 922:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 923:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** /*******************************************************************************
 924:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Function Name  : In0_Process
 925:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Description    : Process the IN token on all default endpoint.
 926:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Input          : None.
 927:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Output         : None.
 928:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Return         : Post0_Process.
 929:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *******************************************************************************/
 930:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** uint8_t In0_Process(void)
 931:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** {
 932:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t ControlState = pInformation->ControlState;
 933:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 934:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if ((ControlState == IN_DATA) || (ControlState == LAST_IN_DATA))
 935:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 936:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     DataStageIn();
 937:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* ControlState may be changed outside the function */
 938:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     ControlState = pInformation->ControlState;
 939:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 940:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 941:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else if (ControlState == WAIT_STATUS_IN)
 942:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 943:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if ((pInformation->USBbRequest == SET_ADDRESS) &&
 944:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         (Type_Recipient == (STANDARD_REQUEST | DEVICE_RECIPIENT)))
 945:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 946:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       SetDeviceAddress(pInformation->USBwValue0);
 947:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       pUser_Standard_Requests->User_SetDeviceAddress();
 948:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 949:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     (*pProperty->Process_Status_IN)();
 950:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     ControlState = STALLED;
 951:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 952:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 953:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
 954:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 955:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     ControlState = STALLED;
 956:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 957:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 958:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   pInformation->ControlState = ControlState;
 959:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 960:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   return Post0_Process();
 961:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** }
 962:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 963:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** /*******************************************************************************
 964:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Function Name  : Out0_Process
 965:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Description    : Process the OUT token on all default endpoint.
 966:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Input          : None.
 967:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Output         : None.
 968:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Return         : Post0_Process.
 969:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *******************************************************************************/
 970:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** uint8_t Out0_Process(void)
 971:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** {
 972:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t ControlState = pInformation->ControlState;
 973:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 974:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if ((ControlState == IN_DATA) || (ControlState == LAST_IN_DATA))
 975:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 976:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     /* host aborts the transfer before finish */
 977:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     ControlState = STALLED;
 978:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 979:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else if ((ControlState == OUT_DATA) || (ControlState == LAST_OUT_DATA))
 980:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 981:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     DataStageOut();
 982:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     ControlState = pInformation->ControlState; /* may be changed outside the function */
 983:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 984:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 985:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else if (ControlState == WAIT_STATUS_OUT)
 986:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 987:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     (*pProperty->Process_Status_OUT)();
 988:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   #ifndef STM32F10X_CL
 989:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     ControlState = STALLED;
 990:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   #endif /* STM32F10X_CL */
 991:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 992:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 993:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 994:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   /* Unexpect state, STALL the endpoint */
 995:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
 996:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
 997:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     ControlState = STALLED;
 998:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 999:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
1000:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   pInformation->ControlState = ControlState;
1001:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
1002:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   return Post0_Process();
1003:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** }
1004:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
1005:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** /*******************************************************************************
1006:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Function Name  : Post0_Process
1007:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Description    : Stall the Endpoint 0 in case of error.
1008:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Input          : None.
1009:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Output         : None.
1010:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Return         : - 0 if the control State is in PAUSE
