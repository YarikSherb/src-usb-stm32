  84:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
  85:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if ((pInformation->USBwValue0 <=
  86:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       Device_Table.Total_Configuration) && (pInformation->USBwValue1 == 0)
  87:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       && (pInformation->USBwIndex == 0)) /*call Back usb spec 2.0*/
  88:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
  89:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pInformation->Current_Configuration = pInformation->USBwValue0;
  90:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pUser_Standard_Requests->User_SetConfiguration();
  91:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     return USB_SUCCESS;
  92:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
  93:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else
  94:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {
  95:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     return USB_UNSUPPORT;
  96:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
  97:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** }
