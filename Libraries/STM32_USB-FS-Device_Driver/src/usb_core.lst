 312:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****           _SetEPRxStatus(Related_Endpoint, EP_RX_VALID);
 313:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         }
 314:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         else
 315:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         {
 316:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         #ifndef STM32F10X_CL
 317:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****           ClearDTOG_RX(Related_Endpoint);
 318:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         #endif /* STM32F10X_CL */
 319:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****           _SetEPRxStatus(Related_Endpoint, EP_RX_VALID);
 320:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         }
 321:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       }
 322:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
 323:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     pUser_Standard_Requests->User_ClearFeature();
