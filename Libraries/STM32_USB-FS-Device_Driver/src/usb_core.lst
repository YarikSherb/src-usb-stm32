 237:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** /*******************************************************************************
 238:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Function Name  : Standard_ClearFeature.
 239:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Description    : Clear or disable a specific feature.
 240:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Input          : None.
 241:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Output         : None.
 242:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** * Return         : - Return USB_SUCCESS, if the request is performed.
 243:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *                  - Return USB_UNSUPPORT, if the request is invalid.
 244:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** *******************************************************************************/
 245:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** RESULT Standard_ClearFeature(void)
 246:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** {
 247:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t     Type_Rec = Type_Recipient;
 248:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   uint32_t     Status;
 249:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 250:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 251:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   if (Type_Rec == (STANDARD_REQUEST | DEVICE_RECIPIENT))
 252:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {/*Device Clear Feature*/
 253:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     ClrBit(pInformation->Current_Feature, 5);
 254:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     return USB_SUCCESS;
 255:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   }
 256:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   else if (Type_Rec == (STANDARD_REQUEST | ENDPOINT_RECIPIENT))
 257:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****   {/*EndPoint Clear Feature*/
 258:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     DEVICE* pDev;
 259:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     uint32_t Related_Endpoint;
 260:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     uint32_t wIndex0;
 261:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     uint32_t rEP;
 262:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c **** 
 263:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     if ((pInformation->USBwValue != ENDPOINT_STALL)
 264:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****         || (pInformation->USBwIndex1 != 0))
 265:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     {
 266:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****       return USB_UNSUPPORT;
 267:./Libraries/STM32_USB-FS-Device_Driver/src/usb_core.c ****     }
